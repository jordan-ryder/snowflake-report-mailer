# Copy to secrets.local.toml and fill in. That file is gitignored; this one is not.
# Entra app registration used by Snowflake to authenticate to Azure.
tenant            = "00000000-0000-0000-0000-000000000000"
client_id         = "00000000-0000-0000-0000-000000000000"
client_secret     = "<entra-client-secret>"

# From `terraform output` in infra/.
acs_host          = "<name>.<region>.communication.azure.com"
sender            = "donotreply@<guid>.azurecomm.net"

report_recipient  = "reports@example.com"
